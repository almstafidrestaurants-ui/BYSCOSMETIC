rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function bounded(value, min, max) {
        return value is string && value.size() >= min && value.size() <= max;
      }

      function validRoleFields(profile, common) {
        let customer = ['address', 'occupation', 'location'];
        let consultant = ['specialization', 'experienceYears', 'previousCompany', 'responsiblePersonCode', 'consultantType'];
        let wholesale = ['businessName', 'businessAddress', 'businessType'];
        return (profile.role == 'customer'
            && profile.keys().hasOnly(common.concat(customer))
            && bounded(profile.address, 8, 300)
            && bounded(profile.occupation, 1, 100)
            && bounded(profile.location, 0, 250))
          || (profile.role == 'consultant'
            && profile.keys().hasOnly(common.concat(consultant))
            && bounded(profile.specialization, 1, 100)
            && bounded(profile.previousCompany, 1, 100)
            && bounded(profile.responsiblePersonCode, 1, 60)
            && profile.experienceYears is string
            && profile.experienceYears.matches('^([0-9]{1,2}|100)$')
            && profile.consultantType in ['consultant', 'team-leader', 'zone-manager', 'sales-coordinator', 'sales-manager'])
          || (profile.role == 'merchant'
            && profile.keys().hasOnly(common.concat(wholesale))
            && bounded(profile.businessName, 1, 100)
            && bounded(profile.businessAddress, 8, 300)
            && bounded(profile.businessType, 1, 100));
      }

      function validProfile() {
        let profile = request.resource.data;
        let common = ['role', 'fullName', 'email', 'phone', 'country', 'governorate'];
        return request.auth.token.email_verified == true
          && profile.keys().hasAll(common)
          && profile.email == request.auth.token.email
          && bounded(profile.fullName, 3, 100)
          && profile.phone is string && profile.phone.matches('^[0-9]{4,20}$')
          && profile.country is string && profile.country.matches('^[A-Z]{2}$')
          && bounded(profile.governorate, 1, 100)
          && validRoleFields(profile, common);
      }

      allow get: if isOwner();
      allow create: if isOwner() && validProfile();
      allow update: if isOwner() && validProfile()
        && request.resource.data.role == resource.data.role;
    }
  }
}
